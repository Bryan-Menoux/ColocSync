# Parametres DEV UNIQUEMENT, ne pas les reutiliser en production.
POSTGRES_PASSWORD=colocsync_dev_local

# Fournir un secret aleatoire dans .env (au moins 32 caracteres).
BETTER_AUTH_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# Sur telephone reel, remplacer localhost par l'IP LAN du PC.
BETTER_AUTH_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:8081

# Adresse IPv4 du PC accessible depuis le telephone sur le meme Wi-Fi.
LAN_IP=127.0.0.1

# Resend
RESEND_API_KEY=
